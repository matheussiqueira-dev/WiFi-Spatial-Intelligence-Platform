{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "data_class": {
      "const": "HOST_NETWORK_TELEMETRY",
      "default": "HOST_NETWORK_TELEMETRY",
      "title": "Data Class",
      "type": "string"
    },
    "evidence_level": {
      "const": "L2_LIVE_UNVALIDATED",
      "default": "L2_LIVE_UNVALIDATED",
      "title": "Evidence Level",
      "type": "string"
    },
    "source": {
      "const": "windows-netsh",
      "default": "windows-netsh",
      "title": "Source",
      "type": "string"
    },
    "sample_id": {
      "format": "uuid",
      "title": "Sample Id",
      "type": "string"
    },
    "collector_id": {
      "format": "uuid",
      "title": "Collector Id",
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "location": {
      "default": "Computador",
      "maxLength": 48,
      "minLength": 1,
      "pattern": "^[^\\W_][\\w .-]*$",
      "title": "Location",
      "type": "string"
    },
    "link_state": {
      "enum": [
        "CONNECTED",
        "DISCONNECTED",
        "UNAVAILABLE"
      ],
      "title": "Link State",
      "type": "string"
    },
    "signal_percent": {
      "anyOf": [
        {
          "maximum": 100,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Signal Percent"
    },
    "channel": {
      "anyOf": [
        {
          "maximum": 233,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Channel"
    },
    "radio_type": {
      "anyOf": [
        {
          "enum": [
            "802.11a",
            "802.11b",
            "802.11g",
            "802.11n",
            "802.11ac",
            "802.11ax",
            "802.11be"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Radio Type"
    },
    "rx_mbps": {
      "anyOf": [
        {
          "maximum": 100000,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rx Mbps"
    },
    "tx_mbps": {
      "anyOf": [
        {
          "maximum": 100000,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tx Mbps"
    },
    "probe_sent": {
      "default": 0,
      "maximum": 3,
      "minimum": 0,
      "title": "Probe Sent",
      "type": "integer"
    },
    "probe_rtt_ms": {
      "items": {
        "maximum": 10000,
        "minimum": 0,
        "type": "number"
      },
      "maxItems": 3,
      "title": "Probe Rtt Ms",
      "type": "array"
    },
    "probe_status": {
      "default": "NOT_RUN",
      "enum": [
        "NOT_RUN",
        "COMPLETED",
        "UNAVAILABLE"
      ],
      "title": "Probe Status",
      "type": "string"
    },
    "collector_error": {
      "anyOf": [
        {
          "enum": [
            "no_adapter",
            "read_failed",
            "unsupported_output",
            "multiple_adapters",
            "permission_required"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Collector Error"
    }
  },
  "required": [
    "sample_id",
    "collector_id",
    "timestamp",
    "link_state"
  ],
  "title": "NetworkSample",
  "type": "object"
}
