# Generate an actual secret with scripts/setup/bootstrap.ps1; never commit .env.
# Bootstrap admin token. Personal role tokens (viewer/operator/admin) are issued in the
# dashboard; only their keyed hashes are stored.
SPATIAL_TOKEN=
# Optional HMAC key (>= 32 chars) for personal token hashes. Empty: derived from
# SPATIAL_TOKEN, so rotating SPATIAL_TOKEN invalidates every personal token.
SPATIAL_ACCESS_TOKEN_KEY=
SPATIAL_DATABASE_URL=sqlite:///./runtime/spatial.db
SPATIAL_RETENTION_EVENTS=10000
SPATIAL_LEGACY_LAB_ENABLED=false
# lab (default) or commercial-br; commercial refuses group B/C/D endpoints with 403.
SPATIAL_CAPABILITY_PROFILE=lab
# Browser origins allowed for REST/WebSocket (JSON list); start.ps1 sets its own ports.
SPATIAL_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]
# Accepted Host headers (JSON list).
SPATIAL_ALLOWED_HOSTS=["127.0.0.1","localhost","api"]
# Swagger/ReDoc load third-party CDN scripts; keep off unless needed locally.
SPATIAL_API_DOCS_ENABLED=false
# Seconds a WebSocket may wait before sending its first {"token": ...} frame.
SPATIAL_WS_AUTH_TIMEOUT_SECONDS=5
# Opt-in for this API process only; no Windows task or pruning is installed.
# Alert webhook (off when empty). Loopback/private IP literal only; secret >= 32 chars.
SPATIAL_ALERT_WEBHOOK_URL=
SPATIAL_ALERT_WEBHOOK_SECRET=
SPATIAL_ALERT_WEBHOOK_INTERVAL_SECONDS=60
SPATIAL_BACKUP_ENABLED=false
SPATIAL_BACKUP_INTERVAL_SECONDS=86400
SPATIAL_BACKUP_DESTINATION=runtime/backups
SPATIAL_RATE_AUTH=30
SPATIAL_RATE_WRITE=60
SPATIAL_RATE_READ=600
# WebSocket (re)connections per peer per minute; failed tokens still count in RATE_AUTH.
SPATIAL_RATE_STREAM=120
# Optional RuView settings. start-ruview.ps1 creates .env.ruview without modifying .env.
SPATIAL_RUVIEW_HTTP_URL=http://127.0.0.1:4860
SPATIAL_RUVIEW_WS_URL=ws://127.0.0.1:4861/ws/sensing
SPATIAL_RUVIEW_STALE_SECONDS=5
# Service credential stays in the backend; never use NEXT_PUBLIC for this value.
SPATIAL_RUVIEW_TOKEN=
